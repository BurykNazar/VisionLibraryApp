<Window
    x:Class="VisionLibraryApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="28,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="50" Height="50" CornerRadius="10" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B9;" FontSize="24" Foreground="White" />
                </Border>

                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Vision Library Lab" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="Лабораторна робота №5: бібліотеки машинного зору" Style="{StaticResource CaptionTextStyle}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Column="2" Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="14,10" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Бібліотека" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="OpenCvSharp" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="ContentGrid" Grid.Row="1" Padding="28" SizeChanged="ContentGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="MainContentRow" Height="*" />
                <RowDefinition x:Name="StackedContentRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SettingsColumn" Width="332" />
                <ColumnDefinition x:Name="WorkspaceColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="SettingsPanel" Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,24,0">
                <StackPanel Spacing="16">
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="14">
                            <StackPanel>
                                <TextBlock Text="Налаштування" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Text="Виберіть сцену та запустіть OpenCV-обробку." Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" />
                            </StackPanel>

                            <ComboBox x:Name="SampleComboBox" Header="Демонстраційне зображення" DisplayMemberPath="Title" SelectionChanged="SampleComboBox_SelectionChanged" />

                            <Button Style="{StaticResource SecondaryButtonStyle}" Click="ImportPhotoButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="15" />
                                    <TextBlock Text="Завантажити фото" />
                                </StackPanel>
                            </Button>

                            <ToggleSwitch x:Name="EdgesToggle" Header="Показувати карту контурів" OffContent="Результат" OnContent="Контури" Toggled="EdgesToggle_Toggled" />

                            <Button Style="{StaticResource PrimaryButtonStyle}" Click="RunDetectionButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="White" />
                                    <TextBlock Text="Запустити детекцію" Foreground="White" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SecondaryButtonStyle}" Click="OpenResultsButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE838;" FontSize="15" />
                                    <TextBlock Text="Відкрити результати" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Пайплайн OpenCV" Style="{StaticResource SectionTitleTextStyle}" />
                            <Grid ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <FontIcon Grid.Row="0" Grid.Column="0" Glyph="&#xE8A3;" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Завантаження зображення у Mat" TextWrapping="Wrap" />

                                <FontIcon Grid.Row="1" Grid.Column="0" Glyph="&#xE790;" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Grayscale, GaussianBlur, Canny" TextWrapping="Wrap" />

                                <FontIcon Grid.Row="2" Grid.Column="0" Glyph="&#xE9D2;" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="DNN face detector або FindContours" TextWrapping="Wrap" />

                                <FontIcon Grid.Row="3" Grid.Column="0" Glyph="&#xE8B9;" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Класифікація фігури й рамка" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="WorkspacePanel" Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18">
                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Знайдено" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock x:Name="DetectedCountText" Text="0" Style="{StaticResource MetricValueTextStyle}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Середня впевненість" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock x:Name="ConfidenceText" Text="0%" Style="{StaticResource MetricValueTextStyle}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Поточна сцена" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock x:Name="SceneText" Text="-" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="ImagesGrid" ColumnSpacing="18" RowSpacing="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="ImagesSecondRow" Height="0" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SourceImageColumn" Width="*" />
                            <ColumnDefinition x:Name="ResultImageColumn" Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Вхідне зображення" Style="{StaticResource SectionTitleTextStyle}" />
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="6" Height="320">
                                    <Image x:Name="SourceImage" Stretch="Uniform" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ResultImageCard" Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="ResultImageTitle" Text="Результат детекції" Style="{StaticResource SectionTitleTextStyle}" />
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="6" Height="320">
                                    <Image x:Name="ResultImage" Stretch="Uniform" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="DetailsGrid" ColumnSpacing="18" RowSpacing="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="DetailsSecondRow" Height="0" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="DetectionsColumn" Width="1.25*" />
                            <ColumnDefinition x:Name="LogColumn" Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Розпізнані об'єкти" Style="{StaticResource SectionTitleTextStyle}" />
                                <ListView x:Name="DetectionsList" MinHeight="210" MaxHeight="280" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="12" Padding="4,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="34" Height="34" CornerRadius="7" Background="{StaticResource AccentSoftBrush}">
                                                    <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Details}" Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding Confidence}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Border x:Name="LogCard" Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Журнал обробки" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBox x:Name="LogTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="210" MaxHeight="280" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextBrush}" Background="#F8FAFC" BorderBrush="{StaticResource StrokeBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
